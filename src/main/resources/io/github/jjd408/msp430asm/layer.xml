<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE filesystem PUBLIC "-//NetBeans//DTD Filesystem 1.2//EN" "http://www.netbeans.org/dtds/filesystem-1_2.dtd">
<filesystem>
    <folder name="Menu">
        <folder name="Help">
            <!-- after Help Contents and the online docs, before About -->
            <folder name="MSP430 Documentation">
                <attr name="position" intvalue="350"/>
            </folder>
        </folder>
    </folder>
    <folder name="Editors">
        <folder name="text">
            <folder name="x-msp430-asm">
                <attr name="SystemFileSystem.localizingBundle" stringvalue="io.github.jjd408.msp430asm.Bundle"/>
                <folder name="SideBar">
                    <!-- the machine code column, just right of the line numbers (at 1000) -->
                    <file name="io-github-jjd408-msp430asm-machinecode-MachineCodeSideBarFactory.instance">
                        <attr name="location" stringvalue="West"/>
                        <attr name="position" intvalue="1300"/>
                        <attr name="instanceOf" stringvalue="org.netbeans.spi.editor.SideBarFactory"/>
                    </file>
                </folder>
                <folder name="FontsColors">
                    <folder name="NetBeans">
                        <folder name="Defaults">
                            <file name="FontsColors.xml" url="FontsColors.xml">
                                <attr name="SystemFileSystem.localizingBundle"
                                      stringvalue="io.github.jjd408.msp430asm.Bundle"/>
                            </file>
                        </folder>
                    </folder>
                </folder>
            </folder>
        </folder>
    </folder>
    <folder name="OptionsDialog">
        <folder name="PreviewExamples">
            <folder name="text">
                <file name="x-msp430-asm" url="PreviewExample.s"/>
            </folder>
        </folder>
    </folder>
</filesystem>
